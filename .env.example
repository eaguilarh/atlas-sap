# ============================================================
# ATLAS - SAP Operations Suite
# Variables de entorno - EJEMPLO (copiar a .env y ajustar)
# ============================================================

# Servidor
PORT=54321
NODE_ENV=development

# Base de datos PostgreSQL
# Formato: postgres://usuario:password@host:puerto/database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atlas

# JWT - CRÍTICO: mínimo 32 caracteres, generar con: openssl rand -base64 32
JWT_SECRET=tu-super-secreto-jwt-de-al-menos-32-caracteres-aqui

# Supabase anon key (para compatibilidad)
SB_ANON=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CORS - Orígenes permitidos (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:54321,https://atlas.easconsulting.com.mx

# APIs de IA (opcionales, para funcionalidades de IA)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
GOOGLE_API_KEY=...

# ============================================================
# NOTAS:
# - NUNCA commitear el archivo .env real
# - JWT_SECRET debe ser único por entorno (dev/staging/prod)
# - En producción, usar secrets manager o variables de entorno del orquestador
# ============================================================