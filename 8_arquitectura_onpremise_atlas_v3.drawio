        </mxCell>

        <!-- SUB-ZONE: BACKEND MODULE -->
        <mxCell id="mod_backend" value="MÓDULO BACKEND API (backend/ — atlas_backend)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontStyle=1;fontSize=12;fontColor=#15803D;startSize=24;" vertex="1" parent="zone_proxmox">
          <mxGeometry x="360" y="50" width="330" height="410" as="geometry" />
        </mxCell>
        <mxCell id="be_express" value="&lt;b&gt;Servidor Express (server.js)&lt;/b&gt;&lt;br&gt;Puerto 54321 / Node.js v20 Runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontColor=#15803D;fontSize=11;" vertex="1" parent="mod_backend">
          <mxGeometry x="15" y="35" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="be_security" value="&lt;b&gt;Seguridad y Control de Acceso&lt;/b&gt;&lt;br&gt;Helmet, CORS Estricto, RateLimit (IP/DDNS),&lt;br&gt;JWT Verification &amp;amp; RBAC (Admin/Director/TQS/Guardia)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontColor=#15803D;fontSize=11;" vertex="1" parent="mod_backend">
          <mxGeometry x="15" y="85" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="be_routes" value="&lt;b&gt;Adaptador PostgREST Compatible&lt;/b&gt;&lt;br&gt;/rest/v1/:table (Filtros eq, in, order, limit)&lt;br&gt;/auth/v1/* (Login, Password, MFA Questions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontColor=#15803D;fontSize=11;" vertex="1" parent="mod_backend">
          <mxGeometry x="15" y="155" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="be_validations" value="&lt;b&gt;Capa de Reglas Operativas &amp;amp; Zod&lt;/b&gt;&lt;br&gt;Normalización de horas y estatus RFC/Sol,&lt;br&gt;Regla: No reprogramar en ejecución,&lt;br&gt;Esquemas estrictos Zod en POST/PATCH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontColor=#15803D;fontSize=11;" vertex="1" parent="mod_backend">
          <mxGeometry x="15" y="220" width="300" height="65" as="geometry" />
        </mxCell>
        <mxCell id="be_cache" value="&lt;b&gt;Motor de Caché RAM y Heurísticas AI&lt;/b&gt;&lt;br&gt;In-Memory Cache (0ms) para consultas globales,&lt;br&gt;Endpoints de alertas proactivas y recomendación TQS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontColor=#15803D;fontSize=11;" vertex="1" parent="mod_backend">
          <mxGeometry x="15" y="295" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="be_dbdriver" value="&lt;b&gt;Pool PostgreSQL (pg.Pool)&lt;/b&gt;&lt;br&gt;Conexión pooling persistente con reintentos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontColor=#15803D;fontSize=11;" vertex="1" parent="mod_backend">
          <mxGeometry x="15" y="355" width="300" height="40" as="geometry" />
        </mxCell>

        <!-- SUB-ZONE: DATABASE MODULE -->
        <mxCell id="mod_db" value="BASE DE DATOS (atlas_postgres)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;fontStyle=1;fontSize=12;fontColor=#7E22CE;startSize=24;" vertex="1" parent="zone_proxmox">
          <mxGeometry x="720" y="50" width="270" height="410" as="geometry" />
        </mxCell>
        <mxCell id="db_pg" value="&lt;b&gt;PostgreSQL 16 Engine&lt;/b&gt;&lt;br&gt;Puerto 5432 (Internal Docker Network)&lt;br&gt;Volumen Persistente atlas_pgdata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;fontColor=#7E22CE;fontSize=11;" vertex="1" parent="mod_db">
          <mxGeometry x="15" y="35" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="db_tables" value="&lt;b&gt;Modelos Relacionales Core&lt;/b&gt;&lt;br&gt;• rfcs (RFCs SAP OnPremise/Cloud)&lt;br&gt;• solicitudes (Folios, Estatus Hist)&lt;br&gt;• tqs_users (Líderes, Colaboradores)&lt;br&gt;• sistemas (Matriz, Titular, Backup)&lt;br&gt;• audit_log (Trazabilidad estricta)&lt;br&gt;• auth_users (Credenciales bcrypt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;fontColor=#7E22CE;fontSize=11;" vertex="1" parent="mod_db">
          <mxGeometry x="15" y="105" width="240" height="135" as="geometry" />
        </mxCell>
        <mxCell id="db_scripts" value="&lt;b&gt;DDL y Migraciones Automáticas&lt;/b&gt;&lt;br&gt;schema_onpremise.sql&lt;br&gt;Startup self-healing en server.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;fontColor=#7E22CE;fontSize=11;" vertex="1" parent="mod_db">
          <mxGeometry x="15" y="255" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- BOUNDARY: GITHUB & DEVOPS -->
        <mxCell id="zone_github" value="GOBERNANZA Y CONTROL DE VERSIONES (GITHUB)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0F172A;fontStyle=1;fontSize=12;fontColor=#0F172A;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="750" y="40" width="310" height="230" as="geometry" />
        </mxCell>
        <mxCell id="gh_repo" value="&lt;b&gt;GitHub Private Repository&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#475569;&#x27;&gt;EAS-Consulting/atlas-sap-operaciones&lt;br&gt;Estructura Monorepo Modular&lt;br&gt;Ramas: main (prod) | develop (stage)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontColor=#0F172A;fontSize=12;" vertex="1" parent="zone_github">
          <mxGeometry x="25" y="40" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gh_actions" value="&lt;b&gt;CI/CD &amp;amp; Automated Sync&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#475569;&#x27;&gt;GitHub Actions: Lint, TypeCheck, Tests&lt;br&gt;Webhook / SSH Deploy a Proxmox&lt;br&gt;Sin secretos en git (.gitignore estricto)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontColor=#0F172A;fontSize=12;" vertex="1" parent="zone_github">
          <mxGeometry x="25" y="125" width="260" height="85" as="geometry" />
        </mxCell>

        <!-- CONNECTING EDGES -->
        <mxCell id="edge1" value="HTTPS (WAN/LAN)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0284C7;strokeWidth=2;fontSize=11;fontColor=#0369A1;" edge="1" parent="1" source="zone_clients" target="fw_forti">
