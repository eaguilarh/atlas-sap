          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge6" value="git push / Pull Request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;strokeDasharray=4;fontSize=11;fontColor=#334155;" edge="1" parent="1" source="zone_proxmox" target="gh_repo">
