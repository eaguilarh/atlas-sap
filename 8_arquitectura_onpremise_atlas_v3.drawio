<mxfile host="app.diagrams.net" agent="ATLAS-architecture-v3" version="24.0.0">
  <diagram name="Arquitectura ATLAS v3 Monorepo Modular" id="ATLAS_v3_Architecture">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- BOUNDARY: CLIENT LAYER -->
        <mxCell id="zone_clients" value="CAPA DE CLIENTE (NAVEGADORES Y USUARIOS)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontStyle=1;fontSize=12;fontColor=#0F2B5C;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c_tqs" value="&lt;b&gt;TQS Leader / Operador&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#64748B;&#x27;&gt;Registro de RFCs, Solicitudes, Bitácora&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=12;" vertex="1" parent="zone_clients">
          <mxGeometry x="20" y="40" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_coord" value="&lt;b&gt;Coordinador KOF / Promotor&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#64748B;&#x27;&gt;Aprobación VOBO, Validación de Ventanas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=12;" vertex="1" parent="zone_clients">
          <mxGeometry x="20" y="100" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_dir" value="&lt;b&gt;Dirección / Guardia ME&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#64748B;&#x27;&gt;Dashboard Ejecutivo, Alertas, Reportes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=12;" vertex="1" parent="zone_clients">
          <mxGeometry x="20" y="160" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- BOUNDARY: EDGE & REVERSE PROXY -->
        <mxCell id="zone_proxy" value="CAPA DE ACCESO Y SEGURIDAD (PERÍMETRO)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontStyle=1;fontSize=12;fontColor=#0F2B5C;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="310" height="230" as="geometry" />
        </mxCell>
        <mxCell id="fw_forti" value="&lt;b&gt;FortiGate / DDNS&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#64748B;&#x27;&gt;easconsulting.fortiddns.com&lt;br&gt;Mapeo WAN:8443 / WAN:54321&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=12;" vertex="1" parent="zone_proxy">
          <mxGeometry x="25" y="40" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="srv_nginx" value="&lt;b&gt;Nginx SSL Proxy (atlas_nginx)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#64748B;&#x27;&gt;Puerto 8443 HTTPS (TLS 1.2/1.3)&lt;br&gt;Certificados SSL Wildcard EAS CA&lt;br&gt;Gzip + Proxy Pass a Express&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="zone_proxy">
          <mxGeometry x="25" y="120" width="260" height="90" as="geometry" />
        </mxCell>

        <!-- BOUNDARY: PROXMOX HYPERVISOR VM -->
        <mxCell id="zone_proxmox" value="HYPERVISOR PROXMOX (VM 10.10.10.102) — DOCKER COMPOSE RUNTIME" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontStyle=1;fontSize=13;fontColor=#0F172A;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="1020" height="490" as="geometry" />
        </mxCell>

        <!-- SUB-ZONE: FRONTEND MODULE -->
        <mxCell id="mod_frontend" value="MÓDULO FRONTEND (frontend/)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontStyle=1;fontSize=12;fontColor=#0369A1;startSize=24;" vertex="1" parent="zone_proxmox">
          <mxGeometry x="30" y="50" width="300" height="240" as="geometry" />
        </mxCell>
        <mxCell id="fe_spa" value="&lt;b&gt;Single Page Application (SPA)&lt;/b&gt;&lt;br&gt;index.html (Vanilla ES6+ Optimizado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0EA5E9;fontColor=#0369A1;fontSize=11;" vertex="1" parent="mod_frontend">
          <mxGeometry x="15" y="35" width="270" height="45" as="geometry" />
        </mxCell>
        <mxCell id="fe_views" value="&lt;b&gt;Vistas Modulares del Negocio&lt;/b&gt;&lt;br&gt;Dashboard, RFCs, Solicitudes, Calendario,&lt;br&gt;Matriz Sistemas, Onboarding, Usuarios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0EA5E9;fontColor=#0369A1;fontSize=11;" vertex="1" parent="mod_frontend">
          <mxGeometry x="15" y="90" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fe_assets" value="&lt;b&gt;Estilos y Recursos Estáticos&lt;/b&gt;&lt;br&gt;styles.css (Design System KOF/EAS),&lt;br&gt;favicon.png, Plantillas Excel de Carga" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0EA5E9;fontColor=#0369A1;fontSize=11;" vertex="1" parent="mod_frontend">
