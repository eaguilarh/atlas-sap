# ============================================================
# ATLAS · SAP Operations Suite — Git Ignore
# ============================================================

# Secretos y variables de entorno críticas
.env
.env.*
!.env.example
secrets/
certs/
*.pem
*.key
*.crt

# Dependencias y artefactos de compilación
node_modules/
.npm/
dist/
build/
coverage/
*.tsbuildinfo

# Respaldos y dumps de bases de datos
backups/
*.sql.bak
*.dump
*.tar.gz
*.sqlite
*.db

# Archivos de ofimática con datos operativos o confidenciales
*.xlsx
*.xlsm
~$*.xlsx
~$*.xlsm
=

# Logs del sistema
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Archivos temporales y de diagnóstico local
scratch/
local-env/
graphify-out/
*.tmp
*.temp

# Archivos del sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
