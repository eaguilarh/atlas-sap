# ============================================================
# ATLAS · SAP Operations Suite — Git Ignore
# ============================================================

# Secretos y variables de entorno críticas
.env
.env.*
!.env.example
secrets/
certs/
*.pem
*.key
*.crt

# Dependencias y artefactos de compilación
node_modules/
.npm/
dist/
build/
coverage/
*.tsbuildinfo

# Respaldos y dumps de bases de datos
backups/
*.sql.bak
*.dump
*.tar.gz
*.sqlite
*.db

# Archivos de ofimática con datos operativos o confidenciales
*.xlsx
*.xlsm
~$*.xlsx
~$*.xlsm
=

# Logs del sistema
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Archivos temporales y de diagnóstico local
scratch/
local-env/
graphify-out/
*.tmp
*.temp

# Archivos del sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Exclusiones de raíz para monorepo limpio (solo se versionan frontend/ y backend/)
/.agents/
/.github/
/.hintrc
/.prettierrc
/*.drawio
/*.pdf
/PLAN_SEPARACION_FRONTEND_BACKEND_GITHUB.md
/REFERENCE_BASELINE.md
/REMEDIATION_SUMMARY.md
/Solicitud_Apertura_Puerto_54321_FortiGate.md
/atlas_n8n_workflows.json
/deploy-proxmox.ps1
/docker-compose.yml
/docker-entrypoint-initdb.sh
/Dockerfile
/eslint.config.mjs
/favicon.png
/image.png
/index.html
/migrations/
/nginx.conf
/package-lock.json
/package.json
/reportes/
/schema_onpremise.sql
/scripts/
/server.js
/src/
/styles.css
/tests/
/tsconfig.json
/vitest.config.ts
/.env.example
