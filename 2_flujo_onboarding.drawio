        <mxCell id="n3" value="&lt;b&gt;Usuario nuevo intenta acceder&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555;&#x27;&gt;Correo o contraseña no reconocidos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;spacing=6;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="40" width="240" height="60" as="geometry" /></mxCell>
