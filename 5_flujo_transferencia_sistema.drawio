<mxfile host="app.diagrams.net" agent="ATLAS-architecture-doc" version="24.0.0">
  <diagram name="Transferencia de sistema SAP" id="Transferencia_de_sistema_SAP">
    <mxGraphModel dx="900" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="580" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n3" value="&lt;b&gt;Admin selecciona sistema&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555;&#x27;&gt;Desde Gestión de Sistemas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;spacing=6;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="40" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="n4" value="&lt;b&gt;Elige nuevo dueño&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555;&#x27;&gt;TQS Leader destino&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;spacing=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A3B66;" vertex="1" parent="1"><mxGeometry x="180" y="140" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="n5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n6" value="&lt;b&gt;Se reasignan los RFCs&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555;&#x27;&gt;Todos los RFCs asociados cambian de dueño&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#274E13;" vertex="1" parent="1"><mxGeometry x="180" y="240" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="n7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n8" value="&lt;b&gt;TQS anterior pierde acceso&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555;&#x27;&gt;Ya no ve el sistema ni sus RFCs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1F;" vertex="1" parent="1"><mxGeometry x="180" y="340" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n10" value="&lt;b&gt;Nuevo TQS gana acceso&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555;&#x27;&gt;Sistema y RFCs visibles en su menú&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#274E13;" vertex="1" parent="1"><mxGeometry x="180" y="440" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
