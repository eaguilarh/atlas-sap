<mxfile host="app.diagrams.net" agent="ATLAS-GitHub-Split-Architecture" version="24.0.0">
  <diagram name="Arquitectura Separacion GitHub Frontend-Backend ATLAS" id="ATLAS_GitHub_Architecture">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- HEADER BANNER -->
        <mxCell id="hdr_banner" value="&lt;b&gt;ATLAS-SAP OPERACIONES — ARQUITECTURA DE REESTRUCTURACIÓN Y DESPLIEGUE CONTINUO&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#CBD5E1;&#x27;&gt;Separación de Responsabilidades: Frontend (eaguilarh01) + Backend (eaguilarh) | Runtime On-Premise Proxmox VE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F2B5C;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1220" height="50" as="geometry" />
        </mxCell>

        <!-- ZONE 1: GITHUB CLOUD ECOSYSTEM -->
        <mxCell id="zone_github" value="GITHUB CLOUD PLATFORM (REPOSITORIOS Y CI/CD)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0F172A;fontStyle=1;fontSize=12;fontColor=#0F172A;startSize=26;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="580" height="340" as="geometry" />
        </mxCell>

        <!-- REPO FRONTEND -->
        <mxCell id="repo_fe" value="&lt;b&gt;Repositorio Frontend&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;color:#0284C7;font-size:11px;&#x27;&gt;https://github.com/eaguilarh01/atlas-frontend&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&#x27;font-size:10px;text-align:left;&#x27;&gt;• index.html (SPA Vanilla JS ES6+)&lt;br&gt;• styles.css (Design System KOF/EAS)&lt;br&gt;• Assets, Favicons, Plantillas Excel&lt;br&gt;• ESLint, Prettier, HTMLHint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontColor=#0F2B5C;fontSize=11;align=center;" vertex="1" parent="zone_github">
          <mxGeometry x="20" y="40" width="250" height="130" as="geometry" />
        </mxCell>

        <!-- REPO BACKEND -->
        <mxCell id="repo_be" value="&lt;b&gt;Repositorio Backend&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;color:#7C3AED;font-size:11px;&#x27;&gt;https://github.com/eaguilarh/atlas-backend&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&#x27;font-size:10px;text-align:left;&#x27;&gt;• server.js (Express REST API / PostgREST)&lt;br&gt;• schema_onpremise.sql (DDL + Migrations)&lt;br&gt;• scripts/ (db-seed, sync, backups)&lt;br&gt;• Dockerfile, docker-compose.yml&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#0F2B5C;fontSize=11;align=center;" vertex="1" parent="zone_github">
          <mxGeometry x="300" y="40" width="250" height="130" as="geometry" />
        </mxCell>

        <!-- ACTIONS PIPELINES -->
        <mxCell id="gh_actions_fe" value="&lt;b&gt;GitHub Actions: Frontend CI&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;color:#64748B;&#x27;&gt;Linting, Validacion W3C,&lt;br&gt;Escaneo SAST Secrets / Token Leaks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#38BDF8;fontColor=#0369A1;fontSize=11;" vertex="1" parent="zone_github">
          <mxGeometry x="20" y="190" width="250" height="55" as="geometry" />
        </mxCell>

        <mxCell id="gh_actions_be" value="&lt;b&gt;GitHub Actions: Backend CI&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;color:#64748B;&#x27;&gt;Pruebas de Integracion API,&lt;br&gt;Linting Node.js, Build de Imagen Docker&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A78BFA;fontColor=#5B21B6;fontSize=11;" vertex="1" parent="zone_github">
          <mxGeometry x="300" y="190" width="250" height="55" as="geometry" />
        </mxCell>

        <mxCell id="deploy_orchestrator" value="&lt;b&gt;Mecanismo de Despliegue Seguro (CD)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;color:#475569;&#x27;&gt;Deploy Keys SSH cifradas (ed25519) + Webhook de Despliegue hacia Proxmox VM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#065F46;fontSize=11;" vertex="1" parent="zone_github">
          <mxGeometry x="20" y="265" width="530" height="55" as="geometry" />
        </mxCell>

        <!-- ZONE 2: SECURITY & PERIMETER -->
        <mxCell id="zone_perimeter" value="PERÍMETRO Y ACCESO SEGURO (FORTINET &amp; SSL)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#EF4444;fontStyle=1;fontSize=12;fontColor=#991B1B;startSize=26;" vertex="1" parent="1">
          <mxGeometry x="660" y="90" width="600" height="340" as="geometry" />
        </mxCell>

        <mxCell id="sec_forti" value="&lt;b&gt;FortiGate NGFW &amp; DDNS&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#64748B;&#x27;&gt;easconsulting.fortiddns.com&lt;br&gt;Virtual IP (VIP) Mappings:&lt;br&gt;WAN:8443 -&gt; LAN 10.10.10.102:8443&lt;br&gt;WAN:54321 -&gt; LAN 10.10.10.102:54321&lt;br&gt;IPS/IDS + GeoIP Filtering&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=11;" vertex="1" parent="zone_perimeter">
          <mxGeometry x="30" y="45" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="sec_ssl" value="&lt;b&gt;Terminación SSL / TLS 1.3&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#64748B;&#x27;&gt;Certificados EAS Wildcard CA&lt;br&gt;Cifrado HSTS (Strict-Transport-Security)&lt;br&gt;Cabeceras CSP, X-Frame, X-XSS&lt;br&gt;Gzip Compression &amp; Static Cache&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=11;" vertex="1" parent="zone_perimeter">
          <mxGeometry x="320" y="45" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="sec_users" value="&lt;b&gt;Matriz de Clientes y Roles de Negocio&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10.5px;color:#334155;&#x27;&gt;• TQS Leaders / Operadores (Gestión Operativa de RFCs y Solicitudes)&lt;br&gt;• Coordinadores KOF / Promotores (Validación y Aprobación VOBO)&lt;br&gt;• Dirección / Guardia ME (KPIs Ejecutivos, Alertas Críticas y SLA)&lt;br&gt;• Administradores ATLAS (Gestión de Usuarios, Sistemas y Auditoría)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=11;" vertex="1" parent="zone_perimeter">
          <mxGeometry x="30" y="190" width="540" height="130" as="geometry" />
        </mxCell>

        <!-- ZONE 3: ON-PREMISE PROXMOX VE RUNTIME -->
        <mxCell id="zone_runtime" value="INFRAESTRUCTURA ON-PREMISE: PROXMOX VE 8.x (VM DOCKER COMPOSE 10.10.10.102)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;fontStyle=1;fontSize=12;fontColor=#0F172A;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1220" height="450" as="geometry" />
        </mxCell>

        <!-- CONTAINER: NGINX -->
        <mxCell id="c_nginx" value="&lt;b&gt;Contenedor: atlas_nginx&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10.5px;color:#1E3A8A;&#x27;&gt;Nginx 1.25 Alpine (Reverse Proxy &amp; Static Web Server)&lt;br&gt;Sirve estáticos /frontend (HTML, CSS, JS, Assets)&lt;br&gt;Proxy reverso a /auth, /rest, /rpc -&gt; atlas_backend:3000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;" vertex="1" parent="zone_runtime">
          <mxGeometry x="30" y="50" width="360" height="100" as="geometry" />
        </mxCell>

        <!-- CONTAINER: BACKEND EXPRESS -->
        <mxCell id="c_backend" value="&lt;b&gt;Contenedor: atlas_backend&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10.5px;color:#5B21B6;&#x27;&gt;Node.js v20 LTS / Express Server (Puerto 3000)&lt;br&gt;Controladores REST: /auth/v1, /rest/v1 (PostgREST Emulated)&lt;br&gt;Motor de Permisos RBAC + Parser de Correo RFC (.eml/.msg)&lt;br&gt;Exportador Excel/CSV + Trazabilidad y Logs de Auditoría&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;fontSize=11;" vertex="1" parent="zone_runtime">
          <mxGeometry x="430" y="50" width="370" height="100" as="geometry" />
        </mxCell>

        <!-- CONTAINER: POSTGRESQL -->
        <mxCell id="c_postgres" value="&lt;b&gt;Contenedor: atlas_postgres&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10.5px;color:#065F46;&#x27;&gt;PostgreSQL 15 On-Premise (Puerto 5432)&lt;br&gt;Tablas: rfcs, solicitudes, tqs_users, audit_logs, sistemas&lt;br&gt;Volumen Persistente:/var/lib/postgresql/data (NVMe ZFS)&lt;br&gt;Copia de Seguridad Diaria Automática (pg_dump + gzip)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontSize=11;" vertex="1" parent="zone_runtime">
          <mxGeometry x="830" y="50" width="360" height="100" as="geometry" />
        </mxCell>

        <!-- CONTAINER: N8N INTEGRATIONS -->
        <mxCell id="c_n8n" value="&lt;b&gt;Contenedor: atlas_n8n&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10.5px;color:#9A3412;&#x27;&gt;Motor de Flujos Operativos y Notificaciones (Puerto 5678)&lt;br&gt;Alertas de Ventana vía Correo / Webhook a TQS Leaders&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#9A3412;fontSize=11;" vertex="1" parent="zone_runtime">
          <mxGeometry x="430" y="180" width="370" height="65" as="geometry" />
        </mxCell>

        <!-- FILE REPOSITORY STRUCTURE PREVIEW -->
        <mxCell id="box_filestructure" value="&lt;b&gt;ESTRUCTURA DE ARBORESCENCIA LOCAL / SERVIDOR TRAS LA SEPARACIÓN&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10.5px;font-family:Courier New, monospace;text-align:left;&#x27;&gt;ATLAS-SAP Operaciones/&lt;br&gt;├── frontend/                     [Repo: https://github.com/eaguilarh01/atlas-frontend]&lt;br&gt;│   ├── index.html                (SPA UI con Filtro Todos / TQS y Módulos de Operación)&lt;br&gt;│   ├── styles.css                (Estilos visuales responsivos KOF / EAS)&lt;br&gt;│   └── assets/                   (Favicon, iconos SVG, plantillas Excel de importación)&lt;br&gt;├── backend/                      [Repo: https://github.com/eaguilarh/atlas-backend]&lt;br&gt;│   ├── server.js                 (Servidor REST Express, Controladores y Autenticación JWT)&lt;br&gt;│   ├── schema_onpremise.sql      (Esquema DDL relacional, índices y constraints)&lt;br&gt;│   ├── scripts/                  (db-seed.js, check_db_status.js, backup-postgres.sh)&lt;br&gt;│   ├── Dockerfile &amp; compose      (Configuración de orquestación de contenedores)&lt;br&gt;│   └── .env.example              (Variables de entorno sin credenciales expuestas)&lt;br&gt;└── docs/                         (Memoria Técnica PDF, Diagramas Draw.io, Manuales)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;fontSize=11;align=left;" vertex="1" parent="zone_runtime">
          <mxGeometry x="30" y="270" width="1160" height="160" as="geometry" />
        </mxCell>

        <!-- CONNECTORS -->
        <mxCell id="conn_1" value="Push / PR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="repo_fe" target="gh_actions_fe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="conn_2" value="Push / PR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="repo_be" target="gh_actions_be">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="conn_3" value="Trigger CD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="gh_actions_fe" target="deploy_orchestrator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="conn_4" value="Trigger CD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="gh_actions_be" target="deploy_orchestrator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="conn_5" value="Deploy SSH / Git Pull" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#047857;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" parent="1" source="deploy_orchestrator" target="c_nginx">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="325" y="445" />
              <mxPoint x="250" y="445" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="conn_6" value="HTTPS (8443)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EF4444;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="sec_forti" target="sec_ssl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="conn_7" value="Proxy Pass (API 3000)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c_nginx" target="c_backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="conn_8" value="TCP / SQL (5432)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c_backend" target="c_postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="conn_9" value="Webhooks / Triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EA580C;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c_backend" target="c_n8n">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
